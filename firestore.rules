rules_version = '2';
// Firestore rules for Signal or Noise classroom mode. Rooms and players hold no personal data:
// a player is only a number with a score. Scores can only grow, by at most 10 points per write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['created', 'next', 'open'])
        && request.resource.data.next == 0 && request.resource.data.open == true;
      // Joining takes the next number: the counter may only go up by one.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1;
      match /players/{pid} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['id', 'score', 'done', 'updated'])
          && request.resource.data.score == 0 && request.resource.data.done == 0
          && string(request.resource.data.id) == pid && request.resource.data.id <= get(/databases/$(database)/documents/rooms/$(code)).data.next;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'done', 'updated'])
          && request.resource.data.score >= resource.data.score && request.resource.data.score <= resource.data.score + 10
          && request.resource.data.done >= resource.data.done && request.resource.data.done <= 5;
      }
    }
  }
}
